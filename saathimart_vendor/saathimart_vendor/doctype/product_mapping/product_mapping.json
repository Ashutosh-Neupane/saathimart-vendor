{
  "name": "Product Mapping",
  "module": "Saathimart Vendor",
  "doctype": "DocType",
  "autoname": "MAP-.YYYY.-.#####",
  "track_changes": 1,
  "fields": [
   {"fieldname": "vendor", "fieldtype": "Data", "label": "Vendor",
    "reqd": 1, "in_list_view": 1,
    "description": "This vendor's own vendor_id (Vendor Config.vendor_id) as known to the hub — not a Link, because the hub's Vendor doctype lives in a completely separate app/database (saathimart), not here. Every other cross-app reference in this app (Webhook Event.target_vendor, Sync Outbox payloads) uses the same plain-Data convention for the same reason."},
   {"fieldname": "barcode", "fieldtype": "Data", "label": "Barcode", "reqd": 1,
    "in_list_view": 1,
    "description": "Physical barcode on the product — the shared key across all vendors"},
   {"fieldname": "item_code", "fieldtype": "Link", "label": "ERPNext Item",
    "options": "Item", "reqd": 1, "in_list_view": 1},
   {"fieldname": "item_name", "fieldtype": "Data", "label": "Item Name",
    "fetch_from": "item_code.item_name", "read_only": 1, "in_list_view": 1},
   {"fieldname": "col_break_1", "fieldtype": "Column Break"},
   {"fieldname": "hub_product_id", "fieldtype": "Data", "label": "Hub Product ID",
    "in_list_view": 1, "description": "SM-PROD-xxx from SaathiMart hub"},
   {"fieldname": "hub_sku", "fieldtype": "Data", "label": "Hub SKU",
    "description": "Hub canonical SKU"},
   {"fieldname": "sync_status", "fieldtype": "Select", "label": "Sync Status",
    "options": "Unmapped\nMapped\nError", "default": "Unmapped",
    "in_list_view": 1, "read_only": 1},
   {"fieldname": "is_active", "fieldtype": "Check", "label": "Active", "default": "1"},
   {"fieldname": "last_synced", "fieldtype": "Datetime", "label": "Last Synced",
    "read_only": 1},
   {"fieldname": "sync_error", "fieldtype": "Small Text", "label": "Last Sync Error",
    "read_only": 1}
  ],
  "title_field": "item_name",
  "search_fields": "barcode,item_code,hub_product_id",
  "permissions": [
   {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
   {"role": "Stock Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
  ]
}
