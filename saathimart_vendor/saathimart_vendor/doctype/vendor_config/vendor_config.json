{
 "name": "Vendor Config",
 "module": "Saathimart Vendor",
 "doctype": "DocType",
 "issingle": 1,
  "fields": [
   {"fieldname": "section_hub", "fieldtype": "Section Break", "label": "Hub Connection"},
   {"fieldname": "hub_url", "fieldtype": "Data", "label": "Hub URL", "reqd": 1,
    "description": "e.g. http://saathimart.localhost:8000"},
   {"fieldname": "vendor_id", "fieldtype": "Data", "label": "Vendor ID", "reqd": 1,
    "description": "Assigned by SaathiMart admin e.g. vendor-a"},
   {"fieldname": "api_key", "fieldtype": "Data", "label": "API Key", "reqd": 1},
   {"fieldname": "api_secret", "fieldtype": "Password", "label": "API Secret", "reqd": 1},
   {"fieldname": "webhook_secret", "fieldtype": "Password", "label": "Webhook Secret",
    "description": "Shared secret for verifying inbound hub webhooks"},
   {"fieldname": "col_break_1", "fieldtype": "Column Break"},
   {"fieldname": "sync_enabled", "fieldtype": "Check", "label": "Sync Enabled", "default": "1"},
   {"fieldname": "hub_status", "fieldtype": "Data", "label": "Hub Status", "read_only": 1,
    "description": "Active / Unreachable — updated every 5 min"},
   {"fieldname": "last_sync_at", "fieldtype": "Datetime", "label": "Last Sync At", "read_only": 1},
   {"fieldname": "last_event_seq", "fieldtype": "Int", "label": "Last Event Seq", "read_only": 1,
    "description": "Last event sequence number pushed to hub for idempotency"},
   {"fieldname": "last_hub_event_seq", "fieldtype": "Int", "label": "Last Hub Event Seq", "read_only": 1,
    "description": "Last event sequence number received from hub for ordering"},
   {"fieldname": "admin_email", "fieldtype": "Data", "label": "Admin Email",
    "description": "Receives alerts when outbox entries die or hub is unreachable"},
  {"fieldname": "section_warehouse", "fieldtype": "Section Break", "label": "Warehouse"},
  {"fieldname": "default_warehouse", "fieldtype": "Link", "label": "Default Warehouse",
   "options": "Warehouse", "reqd": 1},
  {"fieldname": "section_location", "fieldtype": "Section Break", "label": "Location"},
  {"fieldname": "lat", "fieldtype": "Float", "label": "Latitude", "reqd": 1},
  {"fieldname": "lng", "fieldtype": "Float", "label": "Longitude", "reqd": 1},
  {"fieldname": "service_radius_km", "fieldtype": "Float", "label": "Service Radius (km)",
   "default": "5"},
  {"fieldname": "address", "fieldtype": "Small Text", "label": "Address"},
  {"fieldname": "section_reconciliation", "fieldtype": "Section Break", "label": "Reconciliation"},
  {"fieldname": "reconciliation_enabled", "fieldtype": "Check",
   "label": "Hourly Reconciliation Enabled", "default": "1"},
  {"fieldname": "reconciliation_threshold", "fieldtype": "Float",
   "label": "Drift Threshold (units)", "default": "2"},
  {"fieldname": "reconciliation_threshold_pct", "fieldtype": "Float",
   "label": "Drift Threshold (%)", "default": "5"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1}
 ]
}
